            android:name=".IconBlueGlow"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_blue_glow"
            android:roundIcon="@mipmap/ic_blue_glow"
            android:label="@string/app_name"
            android:targetActivity=".MainActivity">
            <intent-filter>
